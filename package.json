{
  "name": "opencode-free-rotator",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode free tier account pooling to bypass 200 req/day limit",
  "main": "server.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "start": "node server.mjs",
    "instances:start": "node cli.mjs start",
    "instances:stop": "node cli.mjs stop",
    "instances:status": "node cli.mjs status",
    "instances:reset-quota": "node cli.mjs reset-quota",
    "probe:api": "node scripts/probe-api.mjs",
    "docs:openapi": "node scripts/dump-openapi.mjs"
  },
  "keywords": [
    "opencode",
    "pooling",
    "free-tier",
    "quota-rotation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
